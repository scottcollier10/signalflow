@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Outfit:wght@300;400;500;600;700;800&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  * {
    box-sizing: border-box;
  }
  
  body {
    @apply bg-neu-bg text-neu-text font-body;
  }
  
  h1, h2, h3, h4, h5, h6 {
    @apply font-display;
  }
}

@layer components {
  /* ========================================
     NEUMORPHIC UTILITIES
     ======================================== */
  
  .neu-raised {
    @apply bg-neu-bg shadow-neu-raised rounded-neu-lg;
  }
  
  .neu-raised-sm {
    @apply bg-neu-bg shadow-neu-raised-sm rounded-neu;
  }
  
  .neu-raised-lg {
    @apply bg-neu-bg shadow-neu-raised-lg rounded-neu-xl;
  }
  
  .neu-inset {
    @apply bg-neu-bg shadow-neu-inset rounded-neu;
  }
  
  .neu-flat {
    @apply shadow-neu-flat rounded-neu-md;
    background: linear-gradient(145deg, #242830, #1a1c22);
  }
  
  .neu-sidebar {
    @apply bg-neu-bg;
    box-shadow: 4px 0 15px rgba(0, 0, 0, 0.3);
  }
  
  /* ========================================
     BUTTON COMPONENTS
     ======================================== */
  
  .btn-primary {
    @apply px-6 py-3 rounded-neu font-semibold shadow-neu-raised-sm;
    @apply transition-all duration-300 ease-out;
    @apply hover:-translate-y-0.5 hover:shadow-neu-raised;
    @apply active:translate-y-0 active:shadow-neu-inset;
    @apply disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0;
    background: linear-gradient(145deg, #b5a8e8, #9b8bd8);
    color: #1e2028;
  }
  
  .btn-secondary {
    @apply px-6 py-3 rounded-neu font-medium shadow-neu-raised-sm;
    @apply bg-neu-bg text-neu-text transition-all duration-300;
    @apply hover:-translate-y-0.5 hover:text-neu-accent;
    @apply active:translate-y-0 active:shadow-neu-inset;
    @apply disabled:opacity-50 disabled:cursor-not-allowed;
  }
  
  .btn-tertiary {
    @apply px-4 py-2 rounded-lg font-medium;
    @apply bg-transparent text-neu-text-muted transition-all duration-300;
    @apply hover:text-neu-accent hover:bg-neu-accent/5;
  }
  
  .btn-icon {
    @apply w-10 h-10 rounded-lg shadow-neu-raised-sm flex items-center justify-center;
    @apply bg-neu-bg text-neu-text-muted transition-all duration-300;
    @apply hover:text-neu-accent hover:scale-105;
    @apply active:scale-95;
  }
  
  .btn-icon-sm {
    @apply w-8 h-8 rounded-lg shadow-neu-raised-sm flex items-center justify-center;
    @apply bg-neu-bg text-neu-text-muted transition-all duration-300;
    @apply hover:text-neu-accent hover:scale-105;
  }
  
  /* ========================================
     BADGE COMPONENTS
     ======================================== */
  
  .badge-success {
    @apply px-3 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wide;
    background: rgba(94, 212, 160, 0.15);
    color: #5ed4a0;
  }
  
  .badge-warning {
    @apply px-3 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wide;
    background: rgba(240, 149, 106, 0.15);
    color: #f0956a;
  }
  
  .badge-error {
    @apply px-3 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wide;
    background: rgba(240, 139, 122, 0.15);
    color: #f08b7a;
  }
  
  .badge-info {
    @apply px-3 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wide;
    background: rgba(77, 201, 176, 0.15);
    color: #4dc9b0;
  }
  
  .badge-neutral {
    @apply px-3 py-1.5 rounded-lg text-xs font-semibold uppercase tracking-wide;
    background: rgba(154, 158, 176, 0.15);
    color: #9a9eb0;
  }
  
  /* ========================================
     INPUT COMPONENTS
     ======================================== */
  
  .input-neu {
    @apply bg-neu-bg text-neu-text px-4 py-3 rounded-neu;
    @apply border border-transparent shadow-neu-inset;
    @apply transition-all duration-300;
    @apply focus:border-neu-accent focus:ring-2 focus:ring-neu-accent/10 focus:outline-none;
    @apply placeholder:text-neu-text-muted;
    @apply disabled:opacity-50 disabled:cursor-not-allowed;
  }
  
  .select-neu {
    @apply input-neu cursor-pointer;
  }
  
  .textarea-neu {
    @apply input-neu resize-none;
  }
  
  /* ========================================
     CARD COMPONENTS
     ======================================== */
  
  .card-neu {
    @apply neu-raised p-6 transition-all duration-400;
    @apply hover:-translate-y-1 hover:shadow-neu-raised-lg;
  }
  
  .card-neu-flat {
    @apply neu-flat p-6;
  }
  
  .card-metric {
    @apply neu-flat p-5;
  }
  
  /* ========================================
     LINK & TEXT UTILITIES
     ======================================== */
  
  .link-neu {
    @apply text-neu-accent underline-offset-2 transition-colors duration-200;
    @apply hover:text-neu-accent-light hover:underline;
  }
  
  .text-gradient-accent {
    @apply bg-gradient-to-r from-neu-accent to-neu-accent-light bg-clip-text text-transparent;
  }
  
  /* ========================================
     DIVIDER UTILITIES
     ======================================== */
  
  .divider-neu {
    @apply h-px bg-gradient-to-r from-transparent via-neu-text-muted/20 to-transparent;
  }
  
  /* ========================================
     SCROLL UTILITIES
     ======================================== */
  
  .scrollbar-neu::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  
  .scrollbar-neu::-webkit-scrollbar-track {
    @apply bg-neu-bg rounded-full;
  }
  
  .scrollbar-neu::-webkit-scrollbar-thumb {
    @apply bg-neu-text-muted/30 rounded-full;
    @apply hover:bg-neu-text-muted/50;
  }
  
  /* ========================================
     ANIMATION UTILITIES
     ======================================== */
  
  .animate-stagger-1 { animation-delay: 0.1s; }
  .animate-stagger-2 { animation-delay: 0.2s; }
  .animate-stagger-3 { animation-delay: 0.3s; }
  .animate-stagger-4 { animation-delay: 0.4s; }
  .animate-stagger-5 { animation-delay: 0.5s; }
  
  /* ========================================
     LOADING STATES
     ======================================== */
  
  .skeleton-neu {
    @apply bg-gradient-to-r from-neu-bg via-neu-shadow-light to-neu-bg;
    @apply bg-[length:200%_100%];
    @apply animate-pulse;
  }
}

@layer utilities {
  /* Custom utility classes */
  .text-balance {
    text-wrap: balance;
  }
}
